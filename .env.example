# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot
ALLOWED_TELEGRAM_USER_IDS=

# Async SQLAlchemy URL; SQLite is the MVP storage
DATABASE_URL=sqlite+aiosqlite:///data/app.db
BACKUP_DIR=./backups
BACKUP_KEEP=14
EXPORT_DIR=./exports
EXPORT_RETENTION_SECONDS=86400
MAX_EXPORT_CONTENT_CHARS=10000000

# Number of parallel processing workers
PROCESSING_CONCURRENCY=2
PROCESSING_TIMEOUT_SECONDS=900
SHUTDOWN_TIMEOUT_SECONDS=30

# Fallback timezone for the user (Phase 11 uses per-user settings)
DEFAULT_TIMEZONE=UTC

# Background worker poll interval, seconds
PROCESSING_POLL_SECONDS=1.0

# Web extraction (Phase 3)
MIN_EXTRACTED_TEXT_LENGTH=300
WEB_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_BYTES=5000000
MAX_REDIRECTS=5
WEB_MAX_ATTEMPTS=3
WEB_BACKOFF_SECONDS=0.5

# Voice/audio (Phase 5)
TEMP_DIR=./temp
MAX_AUDIO_BYTES=20000000
TRANSCRIPTION_TIMEOUT_SECONDS=120

# Video visual analysis (Phase 7)
MAX_VIDEO_BYTES=20000000
MAX_VIDEO_DURATION_SECONDS=7200
VIDEO_FRAME_INTERVAL_SECONDS=20
VIDEO_MAX_FRAMES=120
VIDEO_SCENE_THRESHOLD=0.35

# Telegram documents (PM-03)
MAX_DOCUMENT_BYTES=20000000
MAX_DOCUMENT_TEXT_CHARS=500000

# YouTube (Phase 6)
YOUTUBE_MAX_DURATION_SECONDS=7200
YOUTUBE_MAX_AUDIO_BYTES=50000000
YOUTUBE_MAX_VIDEO_BYTES=50000000
YOUTUBE_MAX_SUBTITLE_BYTES=2000000
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=300
SUBTITLE_LANGS=ru,en

# Instagram Reels (PM-04); cookies are optional and the file must stay outside Git
INSTAGRAM_MAX_DURATION_SECONDS=7200
INSTAGRAM_MAX_AUDIO_BYTES=50000000
INSTAGRAM_MAX_VIDEO_BYTES=50000000
INSTAGRAM_COOKIES_FILE=

# Replaceable LLM provider (Phase 2: openai; Ollama is post-MVP)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_VISION_MODEL=

# Alternative OpenAI-compatible provider. Set LLM_PROVIDER=openrouter to use it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_TRANSCRIPTION_MODEL=
OPENROUTER_VISION_MODEL=
CONTENT_CHUNK_MAX_CHARS=30000
CONTENT_CHUNK_OVERLAP_CHARS=1000
LLM_TIMEOUT_SECONDS=120
